{
  "name": "control-tv-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec node_modules/.cache/control-tv-tests/app-logos.test.js node_modules/.cache/control-tv-tests/import-boundaries.test.js node_modules/.cache/control-tv-tests/model.test.js node_modules/.cache/control-tv-tests/playback.test.js node_modules/.cache/control-tv-tests/sound.test.js node_modules/.cache/control-tv-tests/remote.test.js node_modules/.cache/control-tv-tests/tray.test.js node_modules/.cache/control-tv-tests/interaction.test.js node_modules/.cache/control-tv-tests/screen.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.19.43",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
