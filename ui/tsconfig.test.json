{
  // Compiles only the pure model and its tests to plain ESM so Node's built-in runner can
  // execute them (no test framework). The output stays inside node_modules/.cache, which
  // is git-ignored and already part of the retained ui/node_modules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "node_modules/.cache/control-tv-tests",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/app-logos.ts",
    "src/app-logos.test.ts",
    "src/fixtures.ts",
    "src/json.ts",
    "src/model.ts",
    "src/model.test.ts",
    "src/playback.ts",
    "src/playback.test.ts",
    "src/sound.ts",
    "src/sound.test.ts",
    "src/remote.ts",
    "src/remote.test.ts",
    "src/tray.ts",
    "src/tray.test.ts",
    "src/interaction.ts",
    "src/interaction.test.ts",
    "src/screen.ts",
    "src/screen.test.ts",
    "src/display.ts",
    "src/display.test.ts"
  ],
  "exclude": []
}
