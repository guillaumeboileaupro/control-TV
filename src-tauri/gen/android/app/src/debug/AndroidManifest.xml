<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into debug builds only: the owner's acceptance-mode screen and its export provider.
     Release builds contain neither. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".AcceptanceTraceActivity"
            android:exported="true"
            android:label="control-TV Recette"
            android:taskAffinity=".acceptance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".AcceptanceTraceProvider"
            android:authorities="${applicationId}.acceptance"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/acceptance_trace_paths" />
        </provider>
    </application>
</manifest>
