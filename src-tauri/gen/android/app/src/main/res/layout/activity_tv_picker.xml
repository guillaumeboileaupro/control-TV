<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's TV picker: a compact control-TV panel at the bottom of the screen, over a
     light scrim (tapping it cancels). Insets are applied by WidgetTvPickerActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/picker_scrim"
    android:contentDescription="@string/picker_cancel">

    <LinearLayout
        android:id="@+id/picker_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/picker_panel_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Like the window's app bar: the logo and the wordmark over a thin line. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/picker_wordmark"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_line" />

        <TextView
            android:id="@+id/picker_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/picker_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/picker_searching_label"
                android:indeterminateTint="@color/widget_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/picker_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/picker_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_picker_info" />

            <TextView
                android:id="@+id/picker_note_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/picker_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/picker_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/picker_list_bg"
                android:orientation="vertical"
                android:padding="1dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/picker_retry"
                style="@style/ControlTvPickerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/picker_button_bg"
                android:drawableStart="@drawable/ic_picker_refresh"
                android:drawablePadding="8dp"
                android:text="@string/picker_retry"
                android:textColor="@color/widget_text"
                android:visibility="invisible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/picker_cancel"
                style="@style/ControlTvPickerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/picker_quiet_bg"
                android:fontFamily="sans-serif"
                android:text="@string/picker_cancel"
                android:textColor="@color/widget_muted" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
