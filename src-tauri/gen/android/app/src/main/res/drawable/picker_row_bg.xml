<?xml version="1.0" encoding="utf-8"?>
<!-- The widget TV picker, in the window's style (ui/src/styles.css): one surface, thin lines, 8dp radius. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><color android:color="@color/widget_hover" /></item>
    <item android:state_activated="true"><color android:color="@color/widget_accent_tint" /></item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
