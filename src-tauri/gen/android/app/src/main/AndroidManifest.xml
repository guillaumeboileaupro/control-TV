<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cast discovery (mDNS): reading the Wi-Fi state and holding a multicast lock, without
         which Android filters the multicast replies of the receivers. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.control_tv"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget. The provider is exported because the launcher drives widget
             updates; it only draws. Button taps go to the non-exported tap receiver, so no
             other app can trigger a command. MY_PACKAGE_REPLACED (sent only by the system, to
             this app, after it is updated) redraws the widget with the new resources. -->
        <receiver
            android:name=".ControlTvWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/control_tv_widget_info" />
        </receiver>
        <receiver
            android:name=".WidgetTapReceiver"
            android:exported="false" />
        <!-- The widget's own TV picker: opened only by the widget (not exported), in its own
             task so it never brings up or replaces the main app. -->
        <activity
            android:name=".WidgetTvPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/picker_title"
            android:launchMode="singleTask"
            android:taskAffinity=".widgetpicker"
            android:theme="@style/Theme.ControlTvPicker" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
