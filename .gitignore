# Machine-local agent preferences and private evidence. The shared agent configuration
# (AGENTS.md, CLAUDE.md, .agents/skills/, .agents/inactive-skills/, .claude/skills/) is
# versioned.
/.ai-private/
/.[c]odex/
/.agents/*
!/.agents/skills/
!/.agents/inactive-skills/
/.claude/*
!/.claude/skills/
/CLAUDE.local.md
/AGENTS.override.md

# Local tool output and nested agent worktrees: Graphify's knowledge graph (one per checkout or
# worktree, rebuilt with `graphify update .`) and worktrees created inside this checkout.
# Worktrees beside the checkout are separate directories and need no rule.
/graphify-out/
/.worktrees/
